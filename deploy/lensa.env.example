# Copied to ~/.config/lensa/lensa.env (mode 600) by install.sh when absent. No secrets here: paths only.
LENSA_ROOT=/home/ecs-user/project/rd/platform-ekplorasi
PATH=/home/ecs-user/.nvm/versions/node/v22.23.4/bin:/home/ecs-user/.local/bin:/usr/local/bin:/usr/bin:/bin
PORT=8790
NODE_ENV=production
KUBECONFIG=/home/ecs-user/project/rd/platform-ekplorasi/alibaba.yaml
FABRICX_KUBECONFIG=/home/ecs-user/project/rd/platform-ekplorasi/alibaba.yaml
# Enables the Kebijakan screen (OPA policy gateway); without it the screen answers 501.
# OPA_BIN=/home/<user>/.local/bin/opa
# Besu through bank-gw-1's Besu door (forward `besu` in forwards.conf, local 38545). Without it Lensa uses 127.0.0.1:8545.
# LENSA_BESU_RPC=http://127.0.0.1:38545
# mTLS to the OPA gateways (besu/opa/README.md, "mTLS"): dir with ca.crt, lensa.crt, lensa.key from besu/opa/mtls/gen-certs.sh.
# Turn on only after every gateway serves mTLS; gateway URLs become https by themselves.
# LENSA_GW_MTLS_DIR=/home/<user>/.opa-mtls
