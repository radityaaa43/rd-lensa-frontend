# Copied to ~/.config/lensa/lensa.env (mode 600) by install.sh when absent. No secrets here: paths only.
LENSA_ROOT=/home/ecs-user/project/rd/platform-ekplorasi
PATH=/home/ecs-user/.nvm/versions/node/v22.23.4/bin:/home/ecs-user/.local/bin:/usr/local/bin:/usr/bin:/bin
PORT=8790
# Bind host. Unset = 127.0.0.1 (host service, reached with ssh -L). The pod sets HOST=0.0.0.0.
# HOST=127.0.0.1
NODE_ENV=production
KUBECONFIG=/home/ecs-user/project/rd/platform-ekplorasi/alibaba.yaml
FABRICX_KUBECONFIG=/home/ecs-user/project/rd/platform-ekplorasi/alibaba.yaml
# Kebijakan through the party gateways (zeto S20 a): dir 700 with one token file per party (BI, A, B, C: one line, mode 600), written by the gateway
# operator. The Publisher then POSTs UNSIGNED bundles to each party's sink with that party's client certificate and needs neither OPA_KEYS_DIR nor
# a kubeconfig; leave unset to publish the host way (kubectl + OPA_KEYS_DIR).
# LENSA_SINK_TOKENS_DIR=/home/<user>/.opa-sink-tokens
# Enables the Kebijakan screen (OPA policy gateway); without it the screen answers 501.
# OPA_BIN=/home/<user>/.local/bin/opa
# Besu through bank-gw-1's Besu door (forward `besu` in forwards.conf, local 38545). Without it Lensa uses 127.0.0.1:8545.
# LENSA_BESU_RPC=http://127.0.0.1:38545
# Stealth: every tx bank A/B signs goes to its own node's Besu door (forwards besu-bank-a/b, bank-gw-2..3 in rd-zeto-bank-a/b). Without it: all on LENSA_BESU_RPC.
# Slot order is A,B,C. Bank C (cluster 2) has no host forward: slot C is its public Besu door on bank-gw-4-ext (LoadBalancer behind its ACL; the
# address is the one in the S21 GO text). An empty slot C would send bank C's signed txs through BI's door.
# LENSA_BESU_RPC_BANKS=http://127.0.0.1:38546,http://127.0.0.1:38547,https://<bank-gw-4-ext>:8545
# mTLS to the OPA gateways (besu/opa/README.md, "mTLS"): dir with ca.crt, lensa.crt, lensa.key from besu/opa/mtls/gen-certs.sh.
# Turn on only after every gateway serves mTLS; gateway URLs become https by themselves.
# LENSA_GW_MTLS_DIR=/home/<user>/.opa-mtls
# Optional, until fabricx S19 (analyst Q15): cert directory for the OLD Fabric-X gateways (fx-gw-N), which trust the flat Lensa CA only. Set it to the
# flat directory when LENSA_GW_MTLS_DIR moves to the per-party certs (zeto S21); unset = LENSA_GW_MTLS_DIR for every gateway.
# LENSA_GW_MTLS_DIR_FABRICX=/home/<user>/.opa-mtls
# Fabric-X through its OPA gateways fx-gw-1..4 (forwards fabricx-gw-N, needs LENSA_GW_MTLS_DIR); unset = kubectl exec into rdbi-driver.
# LENSA_FABRICX_GW=1
# Private bundle signing keys (besu/opa/keys.sh); outside the repo; required with OPA_BIN (without it the Kebijakan screen stays off).
# OPA_KEYS_DIR=/home/<user>/.opa-keys
# Per-party gateway endpoints, no kubectl port-forward and no kubeconfig (final-design zeto S19, fabricx S19): the NodePort (cluster 1) or
# LoadBalancer (cluster 2) URL of each party's gateway, mTLS. Unset = today's loopback forward (lensa-pf@*). Not an http(s) URL = the server refuses to start.
# LENSA_GW_PALADIN_BI=https://<ip>:<port>   (also _A, _B, _C)
# Zeto S21: bank C has no loopback forward any more (31848 is gone), so LENSA_GW_PALADIN_C is required, else bank C Zeto calls fail:
# LENSA_GW_PALADIN_C=https://<bank-gw-4-ext>:8548
# LENSA_GW_FABRICX_BI=https://<ip>:<port>   (also _A, _B, _C)
# LENSA_GW_STEALTH_BI=https://<st-gw-1 host>:8550   (also _A, _B, _C; all four or none; pod only: the keyless stealth adapter talks to each party's signer through its st-gw-N door, mTLS servername st-gw-N)
# Iroha 3 (iroha S14.C): EVERY Iroha request (driver routes and Torii reads) goes through the party's mTLS gateway when set, via a Lensa loopback forward of
# svc/gateway:8443 (the gateway cert has a DNS SAN only: Lensa sets SNI + hostname check to gateway.rd-iroha3-<bi|bank-a|bank-b|bank-c>.svc.cluster.local). Unset = plain loopback as today.
# BI, A, B: loopback forwards lensa-pf@iroha-gw-* (forwards.conf). Bank C (cluster 2): no forward, its public gateway-lb (same SNI, mTLS).
# LENSA_GW_IROHA_BI=https://127.0.0.1:38211
# LENSA_GW_IROHA_A=https://127.0.0.1:38212
# LENSA_GW_IROHA_B=https://127.0.0.1:38213
# LENSA_GW_IROHA_C=https://<iroha-gateway-lb-bank-c-ext>:8443
# Per-party Iroha client cert dir (separate from the Paladin one): LENSA_GW_MTLS_DIR_IROHA/<BI|A|B|C>/{server-ca.pem,lensa.crt,lensa.key}; the key stays 0600 (R1 interim, S22 shred list).
# LENSA_GW_MTLS_DIR_IROHA=/home/<user>/.iroha3-lensa
# Per-party client cert: LENSA_GW_MTLS_DIR/<BI|A|B|C>/{ca.crt,lensa.crt,lensa.key}; a party without a subfolder uses the flat files in LENSA_GW_MTLS_DIR.
# Startup check: a set LENSA_GW_* value that is not an http(s) URL, or two endpoints (gateways set or default, LENSA_BESU_RPC, LENSA_BESU_RPC_BANKS doors) with the same host:port, stops the server.
# The besu/ sibling code (zeto, noto) still reads the flat files only: keep them until zeto S19 moves it; after S19 the flat files are removed and only the four party subfolders remain.
