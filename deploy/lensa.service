[Unit]
Description=Eksplorasi Rupiah Digital server (127.0.0.1)
Wants=lensa-pf@paladin-node1.service lensa-pf@paladin-node2.service lensa-pf@paladin-node3.service lensa-pf@besu.service lensa-pf@iroha-bi.service lensa-pf@iroha-bank-a.service lensa-pf@iroha-bank-b.service lensa-pf@iroha-bank-c.service lensa-pf@iroha-auditor.service lensa-pf@besu-bank-a.service lensa-pf@besu-bank-b.service lensa-pf@fabricx-gw-1.service lensa-pf@fabricx-gw-2.service lensa-pf@fabricx-gw-3.service lensa-pf@fabricx-gw-4.service 
After=lensa-pf@paladin-node1.service lensa-pf@paladin-node2.service lensa-pf@paladin-node3.service lensa-pf@besu.service lensa-pf@iroha-bi.service lensa-pf@iroha-bank-a.service lensa-pf@iroha-bank-b.service lensa-pf@iroha-bank-c.service lensa-pf@iroha-auditor.service lensa-pf@besu-bank-a.service lensa-pf@besu-bank-b.service lensa-pf@fabricx-gw-1.service lensa-pf@fabricx-gw-2.service lensa-pf@fabricx-gw-3.service lensa-pf@fabricx-gw-4.service 
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=%h/.config/lensa/lensa.env
ExecStart=/bin/bash -c 'cd "$LENSA_ROOT/frontend" && exec npm start -w server'
ExecStartPost=/bin/bash -c 'exec "$LENSA_ROOT/frontend/deploy/healthwait.sh"'
TimeoutStartSec=120
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
