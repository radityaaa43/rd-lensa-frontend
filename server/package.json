{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "bootstrap": "tsx src/cli/bootstrap.ts",
    "preflight": "tsx src/cli/preflight.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@fastify/static": "^8",
    "fastify": "^5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5.9",
    "vitest": "^2"
  }
}
